# Node.js dependencies
node_modules/
.yarn/
.pnp.*

# Build output
dist/
build/
public/

# Editor & IDEs
.vscode/
.idea/
*.swp

# Logs & Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.DS_Store

# Misc
.eslintcache
.prettierrc
playwright-report/
coverage/

kubeconfig.yaml

scripts/login-response*.json
scripts/credentials*.json
*kubeconfig*

scratchpad.md

scripts/krateoctl-output/*.yaml

.env
.env.local
# krateoctl writes <Widget>.schema.crd.yaml next to each schema and gen-crds.ts moves it to
# scripts/krateoctl-output/. It is a build intermediate, never a source file — two of them were
# committed by accident in the monorepo move and showed up as deletions on every generator run.
ui/src/widgets/*/*.schema.crd.yaml
ui/scripts/krateoctl-output/

# Python bytecode from the design lints. It was tracked by accident and showed up as a
# binary diff on every lint change.
__pycache__/
*.pyc

# Local build artifact — a ~10 MB Go binary that lives in the working tree of anyone who has
# built the voice bridge. It was committed twice by `git add -A` before this entry existed
# (once caught and unstaged, once not), so the rule is written down rather than remembered.
voice-bridge/voice-bridge
