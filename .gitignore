# Node.js dependencies
node_modules/
.yarn/
.pnp.*

# Build output
dist/
build/
public/
# Source, not build output: the public pages (ui/src/public/PublicPage.tsx). Without this a new
# file there is silently left out of `git add`.
!ui/src/public/

# Editor & IDEs
.vscode/
.idea/
*.swp

# Logs & Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.DS_Store

# Misc
.eslintcache
.prettierrc
playwright-report/
coverage/

kubeconfig.yaml

scripts/login-response*.json
scripts/credentials*.json
*kubeconfig*

scratchpad.md

.env
.env.local
# The generator writes <Widget>.schema.crd.yaml next to each schema and gen-crds.ts moves it to
# scripts/generated-crds/. It is a build intermediate, never a source file — two of them were
# committed by accident in the monorepo move and showed up as deletions on every generator run.
ui/src/widgets/*/*.schema.crd.yaml
ui/scripts/generated-crds/

# Python bytecode from the design lints. It was tracked by accident and showed up as a
# binary diff on every lint change.
__pycache__/
*.pyc

# Local build artifact — a ~10 MB Go binary that lives in the working tree of anyone who has
# built the voice bridge. It was committed twice by `git add -A` before this entry existed
# (once caught and unstaged, once not), so the rule is written down rather than remembered.
voice-bridge/voice-bridge

# visual regression (visual/)
dist-visual/
dist-e2e/
test-results/

# The CRD generator is built on demand by ui/scripts/gen-crds.ts (crdgen/doc.go).
crdgen/bin/

# The generator binary, from `go build` in crdgen/. `npm run generate-crds` builds it to
# crdgen/bin/gencrd, which is already ignored; a bare `go build ./...` drops one here instead and
# it was committed by accident once.
crdgen/crdgen

# The same for builder-gate's jq checker: a bare `go build` in builder-gate/jqcheck/ writes this
# file, and an arm64 build of it was committed by accident (#616). CI, the tests and the image
# build their own (bin/jqcheck, /out/jqcheck); nothing reads this one.
builder-gate/jqcheck/jqcheck
