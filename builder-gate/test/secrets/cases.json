[
 {
  "name": "a literal core secrets list",
  "step": {
   "name": "s",
   "path": "/api/v1/secrets"
  },
  "refused": true
 },
 {
  "name": "a namespaced secret by name",
  "step": {
   "name": "s",
   "path": "/api/v1/namespaces/krateo-system/secrets/x"
  },
  "refused": true
 },
 {
  "name": "percent-encoded",
  "step": {
   "name": "s",
   "path": "/api/v1/namespaces/krateo-system/%73ecrets"
  },
  "refused": true
 },
 {
  "name": "double percent-encoded",
  "step": {
   "name": "s",
   "path": "/api/v1/%2573ecrets"
  },
  "refused": true
 },
 {
  "name": "upper case",
  "step": {
   "name": "s",
   "path": "/api/v1/SECRETS"
  },
  "refused": true
 },
 {
  "name": "split into string pieces",
  "step": {
   "name": "s",
   "path": "${ \"/api/v1/\" + \"sec\" + \"rets\" }"
  },
  "refused": true
 },
 {
  "name": "split with separators",
  "step": {
   "name": "s",
   "path": "${ \"/api/v1/\" + (\"s-e-c-r-e-t-s\" | split(\"-\") | join(\"\")) }"
  },
  "refused": true
 },
 {
  "name": "in the iterator",
  "step": {
   "name": "s",
   "path": "${ . }",
   "dependsOn": {
    "name": "a",
    "iterator": "[.a.items[] | \"/api/v1/secrets\"]"
   }
  },
  "refused": true
 },
 {
  "name": "in userAccessFilter.resource",
  "step": {
   "name": "s",
   "path": "/api/v1/pods",
   "userAccessFilter": {
    "verb": "list",
    "group": "",
    "resource": "secrets"
   }
  },
  "refused": true
 },
 {
  "name": "in userAccessFilter.resourcesFrom",
  "step": {
   "name": "s",
   "path": "/api/v1/pods",
   "userAccessFilter": {
    "verb": "list",
    "group": "",
    "resourcesFrom": "[\"secrets\"]"
   }
  },
  "refused": true
 },
 {
  "name": "an endpointRef step naming it",
  "step": {
   "name": "s",
   "path": "/v1/secrets",
   "endpointRef": {
    "name": "e",
    "namespace": "krateo-system"
   }
  },
  "refused": true
 },
 {
  "name": "a data-driven path, unguarded",
  "step": {
   "name": "s",
   "path": "${ .path }",
   "dependsOn": {
    "name": "a",
    "iterator": ".a.paths"
   }
  },
  "refused": true
 },
 {
  "name": "a data-driven core path with no literal resource",
  "step": {
   "name": "s",
   "path": "${ \"/api/v1/namespaces/\" + .ns + \"/\" + .kind }"
  },
  "refused": true
 },
 {
  "name": "a data-driven path guarded by fetchablePath",
  "step": {
   "name": "s",
   "path": "${ . }",
   "dependsOn": {
    "name": "a",
    "iterator": "def fetchableCore: [\"configmaps\", \"pods\", \"namespaces\"]; def fetchablePath: (tostring | split(\"/\")) as $p | true; [ .paths[] | select(fetchablePath) ]"
   }
  },
  "refused": false
 },
 {
  "name": "a guard whose allowlist names secrets",
  "step": {
   "name": "s",
   "path": "${ . }",
   "dependsOn": {
    "name": "a",
    "iterator": "def fetchableCore: [\"configmaps\", \"secrets\"]; def fetchablePath: (tostring | split(\"/\")) as $p | true; [ .paths[] | select(fetchablePath) ]"
   }
  },
  "refused": true
 },
 {
  "name": "plain pods",
  "step": {
   "name": "s",
   "path": "/api/v1/namespaces/krateo-system/pods"
  },
  "refused": false
 },
 {
  "name": "a non-core group, data-driven",
  "step": {
   "name": "s",
   "path": "${ \"/apis/composition.krateo.io/v1/namespaces/\" + .ns + \"/x\" }"
  },
  "refused": false
 },
 {
  "name": "a core path whose resource is a later literal",
  "step": {
   "name": "s",
   "path": "${ \"/api/v1/namespaces/\" + .ns + \"/configmaps/\" + .name }"
  },
  "refused": false
 },
 {
  "name": "a core path fixed in the first literal",
  "step": {
   "name": "s",
   "path": "${ \"/api/v1/namespaces/krateo-system/pods/\" + .name }"
  },
  "refused": false
 },
 {
  "name": "an endpointRef step with a templated path",
  "step": {
   "name": "s",
   "path": "${ \"/v1/things/\" + .id }",
   "endpointRef": {
    "name": "e",
    "namespace": "krateo-system"
   }
  },
  "refused": false
 }
]