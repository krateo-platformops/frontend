exports[`the sign-in card's band and heading > by default: the bundled logo, "Sign in", "to Krateo PlatformOps" 1`] = `"<div class="_band"><img alt="Krateo | PlatformOps" class="_logo" src="/src/assets/images/logo_big.svg"></div><h1 class="_title">Sign in</h1><p class="_to">to Krateo PlatformOps</p>"`;

