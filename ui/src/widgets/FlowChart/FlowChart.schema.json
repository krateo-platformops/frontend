{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "default": "v1beta1",
      "description": "Widget API version."
    },
    "kind": {
      "default": "FlowChart",
      "description": "FlowChart represents a Kubernetes composition as a directed graph. Each node represents a resource, and edges indicate parent-child relationships",
      "type": "string"
    },
    "spec": {
      "type": "object",
      "properties": {
        "widgetData": {
          "type": "object",
          "required": [
            "data"
          ],
          "properties": {
            "data": {
              "type": "array",
              "description": "list of kubernetes resources and their relationships to render as nodes in the flow chart",
              "items": {
                "type": "object",
                "required": [
                  "kind",
                  "name",
                  "uid"
                ],
                "additionalProperties": false,
                "properties": {
                  "date": {
                    "type": "string",
                    "description": "optional date value to be shown in the node, formatted as ISO 8601 string"
                  },
                  "detail": {
                    "type": "string",
                    "description": "architecture variant: the one line under the name, such as the readiness field and its value, a count, or what the node waits for"
                  },
                  "exception": {
                    "type": "object",
                    "additionalProperties": false,
                    "description": "architecture variant: the one marker a node carries, and only when something needs attention",
                    "required": [
                      "label"
                    ],
                    "properties": {
                      "label": {
                        "type": "string",
                        "description": "the Kubernetes condition that is not true",
                        "enum": [
                          "NotReady",
                          "NotSynced"
                        ]
                      },
                      "reason": {
                        "type": "string",
                        "description": "the condition's reason"
                      },
                      "message": {
                        "type": "string",
                        "description": "the condition's message"
                      }
                    }
                  },
                  "icon": {
                    "additionalProperties": false,
                    "type": "object",
                    "description": "custom icon displayed for the resource node",
                    "properties": {
                      "name": {
                        "type": "string",
                        "description": "FontAwesome icon class name (e.g. 'fa-check')"
                      },
                      "color": {
                        "type": "string",
                        "description": "CSS color value for the icon background",
                        "enum": [
                          "blue",
                          "darkBlue",
                          "orange",
                          "gray",
                          "red",
                          "green",
                          "violet"
                        ]
                      },
                      "message": {
                        "type": "string",
                        "description": "optional tooltip message displayed on hover"
                      }
                    }
                  },
                  "statusIcon": {
                    "additionalProperties": false,
                    "type": "object",
                    "description": "custom status icon displayed alongside resource info",
                    "properties": {
                      "name": {
                        "type": "string",
                        "description": "FontAwesome icon class name representing status"
                      },
                      "color": {
                        "type": "string",
                        "description": "CSS color value for the status icon background",
                        "enum": [
                          "blue",
                          "darkBlue",
                          "orange",
                          "gray",
                          "red",
                          "green",
                          "violet"
                        ]
                      },
                      "message": {
                        "type": "string",
                        "description": "optional tooltip message describing the status"
                      }
                    }
                  },
                  "kind": {
                    "type": "string",
                    "description": "kubernetes resource type (e.g. Deployment, Service)"
                  },
                  "name": {
                    "type": "string",
                    "description": "name of the resource"
                  },
                  "namespace": {
                    "type": "string",
                    "description": "namespace in which the resource is defined"
                  },
                  "parentRefs": {
                    "type": "array",
                    "description": "list of parent resources used to define graph relationships",
                    "items": {
                      "type": "object",
                      "properties": {
                        "date": {
                          "type": "string",
                          "description": "optional date value to be shown in the node, formatted as ISO 8601 string"
                        },
                        "icon": {
                          "additionalProperties": false,
                          "type": "object",
                          "description": "custom icon for the parent resource",
                          "properties": {
                            "name": {
                              "type": "string",
                              "description": "FontAwesome icon class name"
                            },
                            "color": {
                              "type": "string",
                              "description": "CSS color value for the icon background",
                              "enum": [
                                "blue",
                                "darkBlue",
                                "orange",
                                "gray",
                                "red",
                                "green",
                                "violet"
                              ]
                            },
                            "message": {
                              "type": "string",
                              "description": "optional tooltip message"
                            }
                          }
                        },
                        "statusIcon": {
                          "additionalProperties": false,
                          "type": "object",
                          "description": "custom status icon for the parent resource",
                          "properties": {
                            "name": {
                              "type": "string",
                              "description": "FontAwesome icon class name"
                            },
                            "color": {
                              "type": "string",
                              "description": "CSS color value for the status icon background",
                              "enum": [
                                "blue",
                                "darkBlue",
                                "orange",
                                "gray",
                                "red",
                                "green",
                                "violet"
                              ]
                            },
                            "message": {
                              "type": "string",
                              "description": "optional tooltip message"
                            }
                          }
                        },
                        "kind": {
                          "type": "string",
                          "description": "resource type of the parent"
                        },
                        "name": {
                          "type": "string",
                          "description": "name of the parent resource"
                        },
                        "namespace": {
                          "type": "string",
                          "description": "namespace of the parent resource"
                        },
                        "parentRefs": {
                          "type": "array",
                          "description": "nested parent references for recursive relationships",
                          "items": {
                            "type": "object"
                          }
                        },
                        "resourceVersion": {
                          "type": "string",
                          "description": "internal version string of the parent resource"
                        },
                        "uid": {
                          "type": "string",
                          "description": "unique identifier of the parent resource"
                        },
                        "version": {
                          "type": "string",
                          "description": "api version of the parent resource"
                        }
                      }
                    }
                  },
                  "resourceVersion": {
                    "type": "string",
                    "description": "internal version string of the resource"
                  },
                  "state": {
                    "type": "string",
                    "description": "architecture variant: where this resource is in the composition's sequence",
                    "enum": [
                      "done",
                      "waiting",
                      "withheld",
                      "unreadable",
                      "unavailable",
                      "unknown"
                    ]
                  },
                  "uid": {
                    "type": "string",
                    "description": "unique identifier of the resource"
                  },
                  "version": {
                    "type": "string",
                    "description": "api version of the resource"
                  }
                }
              }
            },
            "variant": {
              "type": "string",
              "default": "resource",
              "description": "resource: one node per live object, the original card. architecture: one node per resource a chart declares, drawn in the state the composition is in",
              "enum": [
                "resource",
                "architecture"
              ]
            }
          },
          "additionalProperties": false,
          "description": "The properties FlowChart renders. Where FlowChart wraps an antd component these are antd's own prop names, so antd's documentation for that component describes them."
        },
        "apiRef": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Name of the RESTAction resource to call."
            },
            "namespace": {
              "type": "string",
              "description": "Namespace of the RESTAction resource."
            }
          },
          "required": [
            "name",
            "namespace"
          ],
          "additionalProperties": false,
          "description": "Binds this widget to a RESTAction whose response feeds the widgetDataTemplate and resourcesRefsTemplate expressions. Omit it for a widget whose data is entirely static."
        },
        "widgetDataTemplate": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "forPath": {
                "type": "string",
                "description": "Dot-path inside widgetData whose value this expression replaces, for example `items[0].title`."
              },
              "expression": {
                "type": "string",
                "description": "A jq expression evaluated server-side against the apiRef response. Its result replaces the value at forPath."
              }
            },
            "additionalProperties": false
          },
          "description": "Per-field overrides evaluated against the apiRef response, so one authored widget can render live cluster data. Each entry replaces one value inside widgetData."
        },
        "resourcesRefs": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "allowed": {
                    "type": "boolean",
                    "description": "Set server-side: whether the caller may perform this verb. False entries are stripped before the widget renders and are never authored by hand."
                  },
                  "apiVersion": {
                    "type": "string",
                    "description": "Group and version of the referenced resource, for example `widgets.templates.krateo.io/v1beta1`."
                  },
                  "id": {
                    "type": "string",
                    "description": "The author-chosen handle this widget uses to reference the resource, matching a resourceRefId in widgetData."
                  },
                  "name": {
                    "type": "string",
                    "description": "Name of the referenced resource."
                  },
                  "namespace": {
                    "type": "string",
                    "description": "Namespace of the referenced resource."
                  },
                  "payload": {
                    "type": "object",
                    "description": "Body sent with a mutating verb. Ignored for a GET."
                  },
                  "resource": {
                    "type": "string",
                    "description": "Plural resource name, for example `paragraphs`."
                  },
                  "verb": {
                    "type": "string",
                    "enum": [
                      "POST",
                      "PUT",
                      "PATCH",
                      "DELETE",
                      "GET"
                    ],
                    "description": "HTTP verb used to resolve the reference. GET for a read; a mutating verb makes this a write the widget can dispatch."
                  },
                  "slice": {
                    "type": "object",
                    "properties": {
                      "offset": {
                        "type": "integer",
                        "description": "Number of items to skip before the returned page."
                      },
                      "page": {
                        "type": "integer",
                        "description": "One-based page number to return."
                      },
                      "perPage": {
                        "type": "integer",
                        "description": "Maximum items in the returned page."
                      },
                      "continue": {
                        "type": "boolean",
                        "description": "Opaque continuation token from a previous response, used to fetch the next page."
                      }
                    },
                    "required": [
                      "page",
                      "perPage"
                    ],
                    "description": "Server-side paging for this reference: the widget receives one page rather than the whole list."
                  }
                },
                "required": [
                  "id"
                ]
              },
              "description": "One referenced resource. The widget addresses it by its `id`, never by name."
            }
          },
          "required": [
            "items"
          ],
          "description": "The resources this widget references by id. Each entry is resolved server-side and its endpoint handed to the widget; entries the caller may not read are removed before the widget renders, so a denied reference reads as absence rather than as an error."
        },
        "resourcesRefsTemplate": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "iterator": {
                "type": "string",
                "description": "A jq expression selecting the array in the apiRef response to iterate over."
              },
              "template": {
                "type": "object",
                "properties": {
                  "apiVersion": {
                    "type": "string",
                    "description": "Group and version of the referenced resource, for example `widgets.templates.krateo.io/v1beta1`."
                  },
                  "id": {
                    "type": "string",
                    "description": "The author-chosen handle this widget uses to reference the resource, matching a resourceRefId in widgetData."
                  },
                  "name": {
                    "type": "string",
                    "description": "Name of the referenced resource."
                  },
                  "namespace": {
                    "type": "string",
                    "description": "Namespace of the referenced resource."
                  },
                  "payload": {
                    "type": "object",
                    "description": "Body sent with a mutating verb. Ignored for a GET."
                  },
                  "resource": {
                    "type": "string",
                    "description": "Plural resource name, for example `paragraphs`."
                  },
                  "verb": {
                    "type": "string",
                    "enum": [
                      "POST",
                      "PUT",
                      "PATCH",
                      "DELETE",
                      "GET"
                    ],
                    "description": "HTTP verb used to resolve the reference. GET for a read; a mutating verb makes this a write the widget can dispatch."
                  }
                },
                "additionalProperties": false,
                "description": "The resourcesRefs entry emitted for each iterated element; its fields may interpolate that element."
              }
            },
            "additionalProperties": false
          },
          "description": "Generates resourcesRefs entries from the apiRef response \u2014 one per element the iterator yields \u2014 so a widget can reference a list whose length it does not know when authored."
        }
      },
      "required": [
        "widgetData"
      ],
      "additionalProperties": false,
      "description": "The widget's contract: its own data, an optional binding to a RESTAction, the resources it references, and any templated overrides."
    }
  },
  "required": [
    "kind",
    "spec",
    "version"
  ]
}
